# Build artifacts
/build/
/bin/
*.o
*.a
*.so
*.so.*
*.gcda
*.gcno
*.gcov

# Fuzzing artifacts
/fuzz/*_seed_corpus/
/fuzz/artifacts/
/fuzz/findings/
/corpus/
/build/*_seed_corpus/

# Benchmark and test output
/bench/results/
/bench/www/
*.prof
*.svg
/flame.svg

# Coverage
/coverage/

# Runtime files
*.log
*.pid
/core
/core.*

# Editor and OS files
*~
*.swp
*.swo
.DS_Store
.idea/
.vscode/
compile_commands.json

# Local scratch directories
/tmp/
# Keep the example document root out of version control, but not the small
# sample index the Quick Start writes there.
/public/*
!/public/index.html

# Benchmark payloads (generated by bench/make_files.sh)
/bench/www/

# Fuzzing: a crash writes its reproducer here, and libFuzzer grows the corpus
# at runtime. Only the deterministic seeds (fuzz/seed_corpus.py) belong in the
# tree, so the whole corpus directory is ignored.
/fuzz/artifacts/
/fuzz/corpus/

# Python bytecode from the test suites
__pycache__/
*.pyc
